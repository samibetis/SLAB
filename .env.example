# Copia este archivo a .env.local y rellena lo que necesites. .env.local no se sube a git.

# Base de datos (Neon, Supabase u otro Postgres). Sin esta variable, en desarrollo se usa PGlite,
# un Postgres embebido que guarda los datos en .data/pglite. En producción es obligatoria.
# Tras definirla, aplica el esquema una vez con: npm run db:migrate
DATABASE_URL=

# Clave de la API de Claude para "Identificar con IA" en el escáner (opcional). Sin ella el escáner
# funciona igual con OCR y la opción de IA avisa de que no está configurada. Cada identificación cuesta.
ANTHROPIC_API_KEY=

# Fotos reales de cada versión (sellos, 1ª edición...) sacadas de TCGplayer. SOLO DEMOSTRACIÓN: usa su
# buscador web sin acuerdo de uso. Activo en desarrollo; en producción solo con VARIANT_PHOTOS=tcgplayer.
# VARIANT_PHOTOS=off lo apaga siempre.
VARIANT_PHOTOS=

# Clave gratuita de pokemontcg.io (opcional): pasa de 1.000 a 20.000 peticiones al día.
POKEMONTCG_API_KEY=

# Protege los cron (/api/cron/sync-sets y /api/cron/snapshot-prices) en producción. Vercel Cron la manda
# como "Authorization: Bearer <CRON_SECRET>". En desarrollo, sin ella, se pueden llamar a mano.
CRON_SECRET=

# Dirección pública de la web (sitemap, URLs canónicas, imágenes para redes). En Vercel no hace falta:
# se usa la de producción que da Vercel. Ponla si usas un dominio propio, p. ej. https://slab.example.
NEXT_PUBLIC_SITE_URL=

# Enlace para apoyar el proyecto (Patreon, Ko-fi, PayPal...). Sale en el aviso de por qué los precios por
# nota se ponen a mano. Debe empezar por https://. Sin él, el aviso dice que pronto habrá un enlace.
NEXT_PUBLIC_DONATE_URL=

# Proveedor de pago de precios por nota (Scrydex). Preparado pero sin probar contra la API real.
# Con las dos claves, el cron y las consultas guardan el histórico por nota. Pon también
# NEXT_PUBLIC_PAID_PRICES=1 para quitar el aviso de donación y los textos de "ponlos tú".
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=
NEXT_PUBLIC_PAID_PRICES=

# Datos de precio SINTÉTICOS (solo para probar la interfaz). Con PRICE_MOCK=1 las notas sin precio se
# rellenan con datos de ejemplo escalados al raw real, y la interfaz lo marca. Por defecto, apagado.
PRICE_MOCK=
